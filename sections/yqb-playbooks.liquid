{%- comment -%}
  YQB Playbooks: header (tag, heading, intro, "view all" link), a featured
  bundle banner and a grid of product cards.

  Product data (image, title, price, compare-at price, URL) comes from the
  selected product; the text/image settings act as overrides or as fallback
  when no product is selected.

  Blocks:
  - include: bullet in the bundle "includes" list
  - card: product card in the grid
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading_font = s.heading_font
  assign body_font = s.body_font

  assign intro_ratio = 100 | minus: s.heading_ratio

  assign include_blocks = section.blocks | where: 'type', 'include'
  assign card_blocks = section.blocks | where: 'type', 'card'

  assign bundle_text_60 = s.color_bundle_text | color_modify: 'alpha', 0.6
  assign bundle_text_78 = s.color_bundle_text | color_modify: 'alpha', 0.78
  assign bundle_text_50 = s.color_bundle_text | color_modify: 'alpha', 0.5
  assign bundle_text_20 = s.color_bundle_text | color_modify: 'alpha', 0.2

  assign bundle_product = s.bundle_product
  assign bundle_url = s.bundle_link
  if bundle_url == blank and bundle_product != blank
    assign bundle_url = bundle_product.url
  endif
  assign bundle_title = s.bundle_title
  if bundle_title == blank and bundle_product != blank
    assign bundle_title = bundle_product.title
  endif
  assign bundle_image = s.bundle_image
  if bundle_image == blank and bundle_product != blank
    assign bundle_image = bundle_product.featured_image
  endif

  render 'contrast-override', background_color: s.color_bg, text_color: s.color_ink, section_id: section.id
-%}

{%- if s.use_custom_fonts -%}
  {%- liquid
    assign heading_600 = heading_font | font_modify: 'weight', '600'
    assign heading_700 = heading_font | font_modify: 'weight', '700'
    assign heading_800 = heading_font | font_modify: 'weight', '800'
    assign body_600 = body_font | font_modify: 'weight', '600'
  -%}
  <style>
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- if heading_600 %}{{ heading_600 | font_face: font_display: 'swap' }}{% endif -%}
    {%- if heading_700 %}{{ heading_700 | font_face: font_display: 'swap' }}{% endif -%}
    {%- if heading_800 %}{{ heading_800 | font_face: font_display: 'swap' }}{% endif -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {%- if body_600 %}{{ body_600 | font_face: font_display: 'swap' }}{% endif -%}
  </style>
{%- endif -%}

{%- comment -%}
  Dynamic values live in a scoped <style> (not a style="" attribute): font
  fallback_families can contain double quotes that would break the attribute.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .yqb-play {
    --yqb-bg: {{ s.color_bg }};
    --yqb-ink: {{ s.color_ink }};
    --yqb-ink-soft: {{ s.color_ink_soft }};
    --yqb-mute: {{ s.color_mute }};
    --yqb-line: {{ s.color_line }};
    --yqb-violet: {{ s.color_accent }};
    --yqb-aqua: {{ s.color_secondary }};
    --yqb-sun: {{ s.color_highlight }};
    --yqb-card: {{ s.color_card }};
    --yqb-bundle-bg: {{ s.color_bundle_bg }};
    --yqb-bundle-media-bg: {{ s.color_bundle_media_bg }};
    --yqb-bundle-text: {{ s.color_bundle_text }};
    --yqb-bundle-text-60: {{ bundle_text_60 }};
    --yqb-bundle-text-78: {{ bundle_text_78 }};
    --yqb-bundle-text-50: {{ bundle_text_50 }};
    --yqb-bundle-text-20: {{ bundle_text_20 }};
    --yqb-radius: {{ s.radius }}px;
    {%- if s.use_custom_fonts %}
      --yqb-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --yqb-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    {%- endif %}
    --yqb-max-width: {{ s.content_max_width }}px;
    --yqb-head-cols: minmax(0, {{ s.heading_ratio }}fr) minmax(0, {{ intro_ratio }}fr);
    --yqb-head-gap: {{ s.head_gap }}px;
    --yqb-head-mb: {{ s.head_margin }}px;
    --yqb-head-mb-mobile: {{ s.head_margin_mobile }}px;
    --yqb-heading-size: {{ s.heading_size }}px;
    --yqb-heading-max-width: {{ s.heading_max_width }}px;
    --yqb-intro-size: {{ s.intro_size }}px;
    --yqb-intro-max-width: {{ s.intro_max_width }}px;
    --yqb-bundle-shadow: {{ s.bundle_shadow }}px;
    --yqb-bundle-media-min-height: {{ s.bundle_media_height }}px;
    --yqb-bundle-title-size: {{ s.bundle_title_size }}px;
    --yqb-bundle-price-size: {{ s.bundle_price_size }}px;
    --yqb-bundle-mb: {{ s.bundle_margin }}px;
    --yqb-cols: {{ s.columns_desktop }};
    --yqb-cols-tablet: {{ s.columns_tablet }};
    --yqb-cols-mobile: {{ s.columns_mobile }};
    --yqb-grid-gap: {{ s.grid_gap }}px;
    --yqb-card-shadow: {{ s.card_hover_shadow }}px;
    --yqb-card-title-size: {{ s.card_title_size }}px;
    --yqb-card-price-size: {{ s.card_price_size }}px;
    --yqb-thumb-width: {{ s.thumb_width }}px;
    --yqb-pt: {{ s.padding_top }}px;
    --yqb-pb: {{ s.padding_bottom }}px;
    --yqb-px: {{ s.padding_inline }}px;
    --yqb-pt-mobile: {{ s.padding_top_mobile }}px;
    --yqb-pb-mobile: {{ s.padding_bottom_mobile }}px;
    --yqb-px-mobile: {{ s.padding_inline_mobile }}px;
  }
</style>

<div class="section-background color-custom-{{ section.id }}"></div>
<section class="section section--{{ s.section_width }} color-custom-{{ section.id }} yqb-play{% if s.hide_card_desc_mobile %} yqb-play--hide-desc-mobile{% endif %}">
  <div class="yqb-play__inner">
    {%- if s.tag_text != blank or s.heading != blank or s.intro != blank or s.viewall_label != blank -%}
      <div class="yqb-play__head">
        <div>
          {%- if s.tag_text != blank -%}
            <span class="yqb-term{% if s.show_tag_dot %} yqb-term--dot{% endif %}">{{ s.tag_text | escape }}</span>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <{{ s.heading_tag }} class="yqb-play__heading">{{ s.heading }}</{{ s.heading_tag }}>
          {%- endif -%}
        </div>
        <div>
          {%- if s.intro != blank -%}
            <div class="yqb-play__intro">{{ s.intro }}</div>
          {%- endif -%}
          {%- if s.viewall_label != blank -%}
            <a
              {% if s.viewall_link != blank %}
                href="{{ s.viewall_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="yqb-play__viewall"
            >
              {{- s.viewall_label | escape -}}
              {%- if s.viewall_arrow %} <span aria-hidden="true">&rarr;</span>{% endif -%}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if s.show_bundle -%}
      {%- if bundle_url != blank -%}
        <a href="{{ bundle_url }}" class="yqb-bundle">
      {%- else -%}
        <div class="yqb-bundle">
      {%- endif -%}
        <div class="yqb-bundle__media{% if s.show_bundle_stripes %} yqb-bundle__media--stripes{% endif %}">
          {%- if bundle_image != blank -%}
            {{
              bundle_image
              | image_url: width: 900
              | image_tag:
                class: 'yqb-bundle__img',
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 1025px) 40vw, 90vw',
                alt: bundle_title
            }}
          {%- else -%}
            <span class="yqb-bundle__placeholder">{{ s.bundle_placeholder | escape }}</span>
          {%- endif -%}
        </div>
        <div class="yqb-bundle__copy">
          {%- if s.bundle_sticker != blank or s.bundle_meta != blank -%}
            <div class="yqb-bundle__meta">
              {%- if s.bundle_sticker != blank -%}
                <span class="yqb-sticker yqb-sticker--sun">{{ s.bundle_sticker | escape }}</span>
              {%- endif -%}
              {%- if s.bundle_meta != blank -%}
                <span class="yqb-bundle__vol">{{ s.bundle_meta | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if bundle_title != blank -%}
            <h3 class="yqb-bundle__title">{{ bundle_title | escape }}</h3>
          {%- endif -%}
          {%- if s.bundle_desc != blank -%}
            <p class="yqb-bundle__desc">{{ s.bundle_desc | escape }}</p>
          {%- endif -%}
          {%- if include_blocks.size > 0 -%}
            <ul class="yqb-bundle__includes">
              {%- for block in include_blocks -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="yqb-bundle__foot">
            <div class="yqb-price">
              {%- if bundle_product != blank -%}
                {%- if bundle_product.compare_at_price > bundle_product.price -%}
                  <span class="yqb-price__was">{% render 'format-price', price: bundle_product.compare_at_price %}</span>
                {%- endif -%}
                <span class="yqb-price__now">{% render 'format-price', price: bundle_product.price %}</span>
              {%- else -%}
                {%- if s.bundle_price_was != blank -%}
                  <span class="yqb-price__was">{{ s.bundle_price_was | escape }}</span>
                {%- endif -%}
                {%- if s.bundle_price_now != blank -%}
                  <span class="yqb-price__now">{{ s.bundle_price_now | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>
            {%- if s.bundle_button != blank -%}
              <span class="yqb-btn">
                {{- s.bundle_button | escape -}}
                {%- if s.bundle_button_arrow %} <span aria-hidden="true">&rarr;</span>{% endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- if bundle_url != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if card_blocks.size > 0 -%}
      <div class="yqb-grid">
        {%- for block in card_blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product

            assign card_url = b.link
            if card_url == blank and p != blank
              assign card_url = p.url
            endif
            assign card_title = b.title
            if card_title == blank and p != blank
              assign card_title = p.title
            endif
            assign card_image = b.image
            if card_image == blank and p != blank
              assign card_image = p.featured_image
            endif
          -%}
          {%- if card_url != blank -%}
            <a href="{{ card_url }}" class="yqb-card" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="yqb-card" {{ block.shopify_attributes }}>
          {%- endif -%}
            <div class="yqb-card__thumb">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400',
                    sizes: '(min-width: 901px) 150px, 100px',
                    alt: card_title
                }}
              {%- else -%}
                <span class="yqb-card__placeholder">{{ s.card_placeholder | escape }}</span>
              {%- endif -%}
              {%- if b.sticker != blank -%}
                <span class="yqb-sticker yqb-sticker--aqua yqb-card__sticker">{{ b.sticker | escape }}</span>
              {%- endif -%}
            </div>
            <div class="yqb-card__body">
              {%- if b.level != blank -%}
                <p class="yqb-card__level">{{ b.level | escape }}</p>
              {%- endif -%}
              {%- if card_title != blank -%}
                <h3 class="yqb-card__title">{{ card_title | escape }}</h3>
              {%- endif -%}
              {%- if b.desc != blank -%}
                <p class="yqb-card__desc">{{ b.desc | escape }}</p>
              {%- endif -%}
              <div class="yqb-card__foot">
                <div class="yqb-price">
                  {%- if p != blank -%}
                    {%- if p.compare_at_price > p.price -%}
                      <span class="yqb-price__was">{% render 'format-price', price: p.compare_at_price %}</span>
                    {%- endif -%}
                    <span class="yqb-price__now">{% render 'format-price', price: p.price %}</span>
                  {%- else -%}
                    {%- if b.price_was != blank -%}
                      <span class="yqb-price__was">{{ b.price_was | escape }}</span>
                    {%- endif -%}
                    {%- if b.price_now != blank -%}
                      <span class="yqb-price__now">{{ b.price_now | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if b.cta != blank -%}
                  <span class="yqb-card__cta">{{ b.cta | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- if card_url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .yqb-play {
    --yqb-font-heading: var(--font-heading--family);
    --yqb-font-body: var(--font-body--family);

    color: var(--yqb-ink);
    font-family: var(--yqb-font-body);
    padding-block: var(--yqb-pt) var(--yqb-pb);
  }

  .yqb-play *,
  .yqb-play *::before,
  .yqb-play *::after {
    box-sizing: border-box;
  }

  .yqb-play .yqb-play__inner {
    width: 100%;
    max-width: var(--yqb-max-width);
    margin: 0 auto;
    padding-inline: var(--yqb-px);
  }

  /* Head */
  .yqb-play .yqb-play__head {
    display: grid;
    grid-template-columns: var(--yqb-head-cols);
    gap: var(--yqb-head-gap);
    align-items: end;
    margin-bottom: var(--yqb-head-mb);
  }

  .yqb-play .yqb-term {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--yqb-font-heading);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yqb-violet);
    background: var(--yqb-card);
    border: 2px solid var(--yqb-ink);
    border-radius: 999px;
    padding: 8px 16px;
    margin-bottom: 24px;
    box-shadow: 3px 3px 0 var(--yqb-violet);
  }

  .yqb-play .yqb-term--dot::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yqb-aqua);
    border: 2px solid var(--yqb-ink);
  }

  .yqb-play .yqb-play__heading {
    font-family: var(--yqb-font-heading);
    font-style: normal;
    font-weight: 800;
    font-size: clamp(34px, 4.4vw, var(--yqb-heading-size));
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--yqb-ink);
    margin: 0;
    max-width: var(--yqb-heading-max-width);
  }

  .yqb-play .yqb-play__heading em {
    font-style: normal;
    color: var(--yqb-violet);
  }

  .yqb-play .yqb-play__intro {
    font-size: var(--yqb-intro-size);
    line-height: 1.7;
    color: var(--yqb-ink-soft);
    margin: 0 0 18px;
    max-width: var(--yqb-intro-max-width);
  }

  .yqb-play .yqb-play__intro p {
    margin: 0;
  }

  .yqb-play .yqb-play__intro p + p {
    margin-top: 1em;
  }

  .yqb-play .yqb-play__viewall {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--yqb-font-heading);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--yqb-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--yqb-ink);
    padding-bottom: 3px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .yqb-play .yqb-play__viewall:hover {
    color: var(--yqb-violet);
    border-color: var(--yqb-violet);
  }

  /* Stickers */
  .yqb-play .yqb-sticker {
    display: inline-block;
    font-family: var(--yqb-font-heading);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 2px solid var(--yqb-ink);
    border-radius: 6px;
    white-space: nowrap;
    transform: rotate(-3deg);
  }

  .yqb-play .yqb-sticker--sun {
    background: var(--yqb-sun);
    color: var(--yqb-ink);
  }

  .yqb-play .yqb-sticker--aqua {
    background: var(--yqb-aqua);
    color: var(--yqb-ink);
  }

  /* Prices */
  .yqb-play .yqb-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .yqb-play .yqb-price__was {
    font-size: 14px;
    font-weight: 600;
    text-decoration: line-through;
    color: var(--yqb-bundle-text-50);
  }

  .yqb-play .yqb-price__now {
    font-family: var(--yqb-font-heading);
    font-size: var(--yqb-bundle-price-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--yqb-sun);
  }

  /* Bundle banner */
  .yqb-play .yqb-bundle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    background: var(--yqb-bundle-bg);
    color: var(--yqb-bundle-text);
    border: 2px solid var(--yqb-ink);
    border-radius: var(--yqb-radius);
    box-shadow: var(--yqb-bundle-shadow) var(--yqb-bundle-shadow) 0 var(--yqb-violet);
    text-decoration: none;
    overflow: hidden;
    margin-bottom: var(--yqb-bundle-mb);
    transition: transform 0.2s ease;
  }

  .yqb-play a.yqb-bundle:hover {
    transform: translate(-2px, -2px);
  }

  .yqb-play .yqb-bundle__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    min-height: var(--yqb-bundle-media-min-height);
    background: var(--yqb-bundle-media-bg);
    border-right: 2px solid var(--yqb-ink);
  }

  .yqb-play .yqb-bundle__media--stripes::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.06) 0 14px, transparent 14px 28px);
    pointer-events: none;
  }

  .yqb-play .yqb-bundle__img {
    position: relative;
    display: block;
    height: 100%;
    max-height: 380px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 26px rgb(0 0 0 / 0.35));
  }

  .yqb-play .yqb-bundle__placeholder {
    position: relative;
    font-family: var(--yqb-font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--yqb-bundle-text);
    border: 2px dashed var(--yqb-bundle-text-50);
    border-radius: 8px;
    padding: 100px 32px;
  }

  .yqb-play .yqb-bundle__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 40px 40px 36px;
  }

  .yqb-play .yqb-bundle__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }

  .yqb-play .yqb-bundle__vol {
    font-family: var(--yqb-font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yqb-bundle-text-60);
  }

  .yqb-play .yqb-bundle__title {
    font-family: var(--yqb-font-heading);
    font-style: normal;
    font-size: clamp(28px, 3vw, var(--yqb-bundle-title-size));
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--yqb-bundle-text);
    margin: 0 0 14px;
  }

  .yqb-play .yqb-bundle__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--yqb-bundle-text-78);
    margin: 0 0 22px;
    max-width: 560px;
  }

  .yqb-play .yqb-bundle__includes {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--yqb-bundle-text);
  }

  .yqb-play .yqb-bundle__includes li {
    position: relative;
    padding-left: 18px;
  }

  .yqb-play .yqb-bundle__includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--yqb-aqua);
    border: 2px solid var(--yqb-ink);
  }

  .yqb-play .yqb-bundle__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 22px;
    border-top: 1px solid var(--yqb-bundle-text-20);
  }

  .yqb-play .yqb-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--yqb-font-heading);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    padding: 14px 22px;
    background: var(--yqb-sun);
    color: var(--yqb-ink);
    border: 2px solid var(--yqb-ink);
    border-radius: var(--yqb-radius);
    white-space: nowrap;
  }

  /* Card grid */
  .yqb-play .yqb-grid {
    display: grid;
    grid-template-columns: repeat(var(--yqb-cols), minmax(0, 1fr));
    gap: var(--yqb-grid-gap);
  }

  .yqb-play .yqb-card {
    display: grid;
    grid-template-columns: var(--yqb-thumb-width) minmax(0, 1fr);
    gap: 24px;
    min-width: 0;
    padding: 22px;
    background: var(--yqb-card);
    border: 2px solid var(--yqb-ink);
    border-radius: var(--yqb-radius);
    text-decoration: none;
    color: var(--yqb-ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .yqb-play a.yqb-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--yqb-card-shadow) var(--yqb-card-shadow) 0 var(--yqb-violet);
  }

  .yqb-play .yqb-card__thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--yqb-thumb-width);
    height: calc(var(--yqb-thumb-width) * 1.2667);
    background: var(--yqb-bg);
    border: 2px dashed var(--yqb-line);
    border-radius: 8px;
  }

  .yqb-play .yqb-card__thumb img {
    display: block;
    height: 90%;
    width: auto;
    max-width: 90%;
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(26 27 31 / 0.22));
  }

  .yqb-play .yqb-card__placeholder {
    font-family: var(--yqb-font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--yqb-mute);
    padding: 8px;
  }

  .yqb-play .yqb-card__sticker {
    position: absolute;
    top: -8px;
    left: -8px;
  }

  .yqb-play .yqb-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .yqb-play .yqb-card__level {
    font-family: var(--yqb-font-heading);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yqb-violet);
    margin: 0 0 8px;
  }

  .yqb-play .yqb-card__title {
    font-family: var(--yqb-font-heading);
    font-style: normal;
    font-size: var(--yqb-card-title-size);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--yqb-ink);
    margin: 0 0 8px;
  }

  .yqb-play .yqb-card__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--yqb-mute);
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .yqb-play .yqb-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--yqb-line);
  }

  .yqb-play .yqb-card .yqb-price__was {
    color: var(--yqb-mute);
  }

  .yqb-play .yqb-card .yqb-price__now {
    color: var(--yqb-ink);
    font-size: var(--yqb-card-price-size);
  }

  .yqb-play .yqb-card__cta {
    font-family: var(--yqb-font-heading);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--yqb-ink);
    border: 2px solid var(--yqb-ink);
    border-radius: 8px;
    padding: 9px 14px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .yqb-play a.yqb-card:hover .yqb-card__cta {
    background: var(--yqb-aqua);
  }

  .yqb-play a:focus-visible {
    outline: 2px solid var(--yqb-violet);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .yqb-play .yqb-bundle,
    .yqb-play .yqb-card {
      transition: none;
    }

    .yqb-play a.yqb-bundle:hover,
    .yqb-play a.yqb-card:hover {
      transform: none;
    }
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .yqb-play .yqb-bundle {
      grid-template-columns: minmax(0, 1fr);
    }

    .yqb-play .yqb-bundle__media {
      border-right: none;
      border-bottom: 2px solid var(--yqb-ink);
      min-height: calc(var(--yqb-bundle-media-min-height) * 0.765);
    }

    .yqb-play .yqb-bundle__img {
      max-height: 300px;
    }

    .yqb-play .yqb-grid {
      grid-template-columns: repeat(var(--yqb-cols-tablet), minmax(0, 1fr));
    }
  }

  /* Mobile */
  @media (max-width: 900px) {
    .yqb-play {
      padding-block: var(--yqb-pt-mobile) var(--yqb-pb-mobile);
    }

    .yqb-play .yqb-play__inner {
      padding-inline: var(--yqb-px-mobile);
    }

    .yqb-play .yqb-play__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      margin-bottom: var(--yqb-head-mb-mobile);
    }

    .yqb-play .yqb-bundle {
      box-shadow: calc(var(--yqb-bundle-shadow) * 0.8) calc(var(--yqb-bundle-shadow) * 0.8) 0 var(--yqb-violet);
    }

    .yqb-play .yqb-bundle__copy {
      padding: 26px 22px;
    }

    .yqb-play .yqb-bundle__includes {
      grid-template-columns: 1fr;
    }

    .yqb-play .yqb-grid {
      grid-template-columns: repeat(var(--yqb-cols-mobile), minmax(0, 1fr));
    }

    .yqb-play .yqb-card {
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 16px;
      padding: 16px;
    }

    .yqb-play .yqb-card__thumb {
      width: 100px;
      height: 128px;
    }

    .yqb-play .yqb-card__title {
      font-size: calc(var(--yqb-card-title-size) * 0.834);
    }

    .yqb-play--hide-desc-mobile .yqb-card__desc {
      display: none;
    }

    .yqb-play .yqb-card__foot {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

