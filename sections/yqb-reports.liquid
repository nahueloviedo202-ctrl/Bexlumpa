    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Fondo de tarjetas",
      "default": "#F7F4EC"
    },
    {
      "type": "color",
      "id": "color_card_head",
      "label": "Fondo de cabecera de tarjetas",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de tarjetas",
      "min": 0,
      "max": 40,
      "step": 1,
