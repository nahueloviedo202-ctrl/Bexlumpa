      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Lateral",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Espaciado mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Lateral",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "YQB Reports",
      "blocks": {
        "card_1": {
          "type": "_yqb-report-card",
          "settings": {
            "school": "Blue Lane Swim School",
            "term": "After 2 terms",
            "quote": "We were losing a third of families every January and calling it normal. The trial follow-up and the re-enrolment window filled term two before the holidays, with a waitlist.",
            "name": "Hannah Price",
            "role": "Owner, Blue Lane Swim School, 310 swimmers",
            "sticker": "Full"
          },
          "blocks": {
            "grade_1": {
              "type": "_yqb-report-grade",
              "settings": { "name": "Trial to enrolment", "before": "38%", "after": "74%" }
